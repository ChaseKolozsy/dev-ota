{
  "id": "macro-cradlespeak-revvl7-en-then-hu-sharded",
  "name": "CS E2E 14 — REVVL7 clean English then Hungarian sharded install",
  "priority": 18000,
  "steps": [
    {
      "id": "order-r7-01",
      "type": "device",
      "value": "{\"action\":\"assertDeviceProfile\",\"args\":{\"profile\":\"revvl7pro-android36-1080x2436\",\"models\":[\"TMRV07P5G\",\"sdk_gphone64_x86_64\"],\"androidSdk\":36,\"shortSidePx\":1080,\"longSidePx\":2436,\"densityDpi\":480},\"capture\":true,\"label\":\"Require REVVL7 Pro or profile-matched Android 36 emulator\"}",
      "delaySeconds": 0.0
    },
    {
      "id": "order-r7-02",
      "type": "device",
      "value": "{\"action\":\"launchApp\",\"args\":{\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":true,\"label\":\"First functional launch of clean Cradlespeak\",\"expect\":{\"activePackage\":\"io.github.chasekolozsy.cradlespeak\"}}",
      "delaySeconds": 3.0
    },
    {
      "id": "order-r7-03",
      "type": "device",
      "value": "{\"action\":\"localHttpAssert\",\"args\":{\"url\":\"http://127.0.0.1:8002/capabilities\",\"expectedStatus\":200,\"jsonPathEquals\":{\"embedded\":true,\"ready\":false,\"reason\":\"language_packs_missing\"},\"jsonPaths\":[\"server_version\",\"default_lang\",\"features\"],\"timeoutSeconds\":15,\"retryUntilSeconds\":180,\"retryIntervalSeconds\":2,\"captureIntervalSeconds\":30},\"capture\":true,\"label\":\"Fail closed unless embedded store is a fresh no-pack baseline\"}",
      "delaySeconds": 0.0
    },
    {
      "id": "order-r7-04",
      "type": "device",
      "value": "{\"action\":\"localHttpAssert\",\"args\":{\"url\":\"http://127.0.0.1:8002/keys/migrations/pending\",\"expectedStatus\":200,\"bodyIncludes\":[\"\\\"pending\\\":[]\"],\"timeoutSeconds\":15,\"retryUntilSeconds\":60,\"retryIntervalSeconds\":2},\"capture\":true,\"label\":\"Require no pending entitlement migration\"}",
      "delaySeconds": 0.0
    },
    {
      "id": "order-r7-05-en",
      "type": "device",
      "value": "{\"action\":\"localHttpAssert\",\"args\":{\"url\":\"http://127.0.0.1:8002/packs/presence?sku=en-v2\",\"expectedStatus\":404,\"timeoutSeconds\":15},\"capture\":true,\"label\":\"Require no existing English pack inventory\"}",
      "delaySeconds": 0.0
    },
    {
      "id": "order-r7-06-hu",
      "type": "device",
      "value": "{\"action\":\"localHttpAssert\",\"args\":{\"url\":\"http://127.0.0.1:8002/packs/presence?sku=hu-v2\",\"expectedStatus\":404,\"timeoutSeconds\":15},\"capture\":true,\"label\":\"Require no existing Hungarian pack inventory\"}",
      "delaySeconds": 0.0
    },
    {
      "id": "order-r7-07",
      "type": "device",
      "value": "{\"action\":\"tapUi\",\"args\":{\"selector\":{\"contentDescription\":\"English\"},\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":true,\"label\":\"Choose English interface\",\"expect\":{\"activePackage\":\"io.github.chasekolozsy.cradlespeak\"}}",
      "delaySeconds": 3.0
    },
    {
      "id": "order-r7-08",
      "type": "device",
      "value": "{\"action\":\"tapUi\",\"args\":{\"selector\":{\"className\":\"android.widget.Button\",\"centerRegion\":{\"left\":0.8,\"top\":0.0,\"right\":1.0,\"bottom\":0.15}},\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":true,\"label\":\"Skip optional LAN content source using normalized top-right close control\",\"expect\":{\"activePackage\":\"io.github.chasekolozsy.cradlespeak\"}}",
      "delaySeconds": 8.0
    },
    {
      "id": "order-r7-09",
      "type": "device",
