      "type": "device",
      "value": "{\"action\":\"tapUi\",\"args\":{\"selector\":{\"contentDescription\":\"Close\",\"className\":\"android.widget.Button\"},\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":true,\"label\":\"Capture and close timeout dialog if still visible\",\"allowError\":true}",
      "delaySeconds": 1.0
    },
    {
      "id": "order-r7-17-top",
      "type": "device",
      "value": "{\"action\":\"swipe\",\"args\":{\"x1Normalized\":0.5,\"y1Normalized\":0.3,\"x2Normalized\":0.5,\"y2Normalized\":0.88,\"durationMs\":600,\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":true,\"label\":\"Return to Marketplace language filters after English install\",\"expect\":{\"activePackage\":\"io.github.chasekolozsy.cradlespeak\"}}",
      "delaySeconds": 2.0
    },
    {
      "id": "order-r7-18-top",
      "type": "device",
      "value": "{\"action\":\"swipe\",\"args\":{\"x1Normalized\":0.5,\"y1Normalized\":0.3,\"x2Normalized\":0.5,\"y2Normalized\":0.88,\"durationMs\":600,\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":true,\"label\":\"Reveal Marketplace language filters\",\"expect\":{\"activePackage\":\"io.github.chasekolozsy.cradlespeak\",\"textIncludes\":[\"HU\"]}}",
      "delaySeconds": 2.0
