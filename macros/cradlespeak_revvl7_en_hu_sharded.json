      "delaySeconds": 2.0
    },
    {
      "id": "order-r7-14-en",
      "type": "device",
      "value": "{\"action\":\"tapUi\",\"args\":{\"selector\":{\"contentDescription\":\"Download\",\"className\":\"android.widget.Button\"},\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":false,\"label\":\"Start exactly one English download\"}",
      "delaySeconds": 1.0
