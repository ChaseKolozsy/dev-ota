      "type": "device",
      "value": "{\"action\":\"swipe\",\"args\":{\"x1Normalized\":0.5,\"y1Normalized\":0.82,\"x2Normalized\":0.5,\"y2Normalized\":0.46,\"durationMs\":400,\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":true,\"label\":\"Reveal Hungarian Download action on REVVL7\",\"expect\":{\"activePackage\":\"io.github.chasekolozsy.cradlespeak\",\"textIncludes\":[\"Download\"]}}",
      "delaySeconds": 2.0
