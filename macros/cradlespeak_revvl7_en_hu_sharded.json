      "type": "device",
      "value": "{\"action\":\"tapUi\",\"args\":{\"selector\":{\"contentDescriptionExact\":\"HU\",\"classNameExact\":\"android.widget.Button\"},\"packageName\":\"io.github.chasekolozsy.cradlespeak\"},\"capture\":true,\"label\":\"Filter Hungarian\",\"expect\":{\"activePackage\":\"io.github.chasekolozsy.cradlespeak\",\"textIncludes\":[\"Hungarian\"]}}",
      "delaySeconds": 2.0
    },
    {
