      "type": "device",
      "value": "{\"action\":\"localHttpAssert\",\"args\":{\"url\":\"http://127.0.0.1:8002/market-client/install-status?sku=hu-v2\",\"expectedStatus\":200,\"jsonPathEquals\":{\"phase\":\"done\"},\"jsonPaths\":[\"phase\",\"bytes_done\",\"bytes_total\",\"updated_at\"],\"timeoutSeconds\":30,\"retryUntilSeconds\":3600,\"retryIntervalSeconds\":5,\"captureIntervalSeconds\":60},\"capture\":true,\"label\":\"Observe Hungarian install through and beyond any 10-minute UI timeout\"}",
      "delaySeconds": 0.0
